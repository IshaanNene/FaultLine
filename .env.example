# Copy to .env for local development. Nothing here is a real secret.

FAULTLINE_ENVIRONMENT=local
FAULTLINE_LOG_LEVEL=INFO

# memory: no infrastructure needed, used by the tests and `faultline demo`.
# live:   Postgres + Redis, via docker compose up -d.
FAULTLINE_BACKEND=memory

FAULTLINE_POSTGRES_DSN=postgresql://faultline:faultline@localhost:5432/faultline
FAULTLINE_REDIS_URL=redis://localhost:6379/0

FAULTLINE_GATEWAY_URL=http://localhost:8081
# Injected from a secret store outside local development.
FAULTLINE_GATEWAY_SIGNING_KEY=dev-only-not-a-secret

# Investigation ceilings. ~0.5M tokens is roughly what SREGym measured for a
# specialized SRE agent, against 1.6-1.9M for general coding agents.
FAULTLINE_BUDGET_MAX_TOKENS=500000
FAULTLINE_BUDGET_MAX_USD=2.50
FAULTLINE_BUDGET_MAX_TOOL_CALLS=40
FAULTLINE_BUDGET_DEADLINE_SECONDS=300
FAULTLINE_MAX_ITERATIONS=4

# stub:      deterministic, no API key, what CI runs on.
# anthropic: hosted models. Needs ANTHROPIC_API_KEY or an `ant auth login` profile.
# ollama:    local models. No key, no per-token cost; needs `ollama serve`.
FAULTLINE_MODEL_PROVIDER=stub

# Bare model ids -- a date-suffixed id is rejected as an unknown model.
FAULTLINE_MODEL_FRONTIER=claude-opus-5
FAULTLINE_MODEL_SMALL=claude-haiku-4-5

# Second model per tier. The router fails over when the first one's breaker
# opens, so a provider incident is a slower investigation, not a lost one.
FAULTLINE_MODEL_FRONTIER_FALLBACK=claude-sonnet-5
FAULTLINE_MODEL_SMALL_FALLBACK=

# ANTHROPIC_API_KEY=

# Ollama. Local inference is free but slow, so on this tier the deadline binds
# long before the dollar ceiling does -- raise it well above the hosted default.
FAULTLINE_OLLAMA_HOST=http://localhost:11434
FAULTLINE_OLLAMA_FRONTIER=llama3.1:8b
FAULTLINE_OLLAMA_SMALL=llama3.2:3b

# Retrieval corpus. An absent corpus is supported: search_knowledge abstains and
# logs a knowledge gap, exactly as it does when nothing is relevant.
FAULTLINE_CORPUS_PATH=corpus
FAULTLINE_EMBED_PROVIDER=ollama
FAULTLINE_EMBED_MODEL=nomic-embed-text
