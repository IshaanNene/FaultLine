# Copy to .env for local development. Nothing here is a real secret.

FAULTLINE_ENVIRONMENT=local
FAULTLINE_LOG_LEVEL=INFO

# memory: no infrastructure needed, used by the tests and `faultline demo`.
# live:   Postgres + Redis, via docker compose up -d.
FAULTLINE_BACKEND=memory

FAULTLINE_POSTGRES_DSN=postgresql://faultline:faultline@localhost:5432/faultline
FAULTLINE_REDIS_URL=redis://localhost:6379/0

FAULTLINE_GATEWAY_URL=http://localhost:8081
# Injected from a secret store outside local development.
FAULTLINE_GATEWAY_SIGNING_KEY=dev-only-not-a-secret

# Investigation ceilings. ~0.5M tokens is roughly what SREGym measured for a
# specialized SRE agent, against 1.6-1.9M for general coding agents.
FAULTLINE_BUDGET_MAX_TOKENS=500000
FAULTLINE_BUDGET_MAX_USD=2.50
FAULTLINE_BUDGET_MAX_TOOL_CALLS=40
FAULTLINE_BUDGET_DEADLINE_SECONDS=300
FAULTLINE_MAX_ITERATIONS=4

# stub: deterministic, no API key, what CI runs on.
FAULTLINE_MODEL_PROVIDER=stub
FAULTLINE_MODEL_FRONTIER=claude-opus-5
FAULTLINE_MODEL_SMALL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=
